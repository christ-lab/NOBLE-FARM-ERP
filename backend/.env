# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DATABASE=${DATABASE_URL}

# JWT Secret for authentication
JWT_SECRET=${JWT_SECRET_KEY}

# Node Environment
NODE_ENV=production

# OpenSSL Legacy Provider (for Node compatibility)
OPENSSL_CONF=/dev/null

# Public Server URL (for frontend to connect)
PUBLIC_SERVER_FILE=https://noble-farm-erp-backend.onrender.com

# Server Port
PORT=10000

# Optional: Resend API for emails
# RESEND_API=your_resend_api_key

# Optional: OpenAI API for AI features
# OPENAI_API_KEY=your_openai_api_key
